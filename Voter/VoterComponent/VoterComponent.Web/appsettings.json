{
  "Voter": {
    "CookieName": ".ChainBallot.Voter.Session",
    "CynetAuthBaseUrl": "https://localhost:5081/",
    "ElectionAuthorizationBaseUrl": "https://localhost:5091/",
    "QueueMode": "Kafka",
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "Topic": "chainballot-ballots"
    },
    "MetadataEndpointTemplate": "https://metadata.example/api/elections/{electionId}.json",
    "DefaultElectionId": "election-demo",
    "BallotEncryptionKey": "CHANGE_ME_VOTER_BALLOT_ENCRYPTION_KEY_1234567890",
    "SubmissionOutboxPath": "",
    "SubmissionOutboxEntryTtlMinutes": 1440,
    "SubmissionOutboxMaxRetryCount": 10,
    "SubmissionOutboxMaxEntries": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
