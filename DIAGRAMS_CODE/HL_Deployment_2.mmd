---
title: Figure 5.2 (2/3) - Backend Data, Settlement & Event Messaging
config:
  layout: elk
  flowchart:
    rankSpacing: 80
    nodeSpacing: 50
---
flowchart TD
    %% Physical/deployment view:
    %% - Configuration runs locally on an administrator workstation.
    %% - Worker pods scale from both CPU utilization and Kafka lag.
    %% Split 2/3: shared data tier, settlement ledger & broker messaging.
    %% UI_TIER/API_TIER below are the SAME pods shown in HL_Deployment_1.mmd,
    %% repeated here (identical replicas/colors) as sources into this tier.
    %% Subgraphs use a vertical (TB) internal layout to keep the render
    %% narrow/tall.

    classDef voter fill:#80B1D3,stroke:#777777,color:#222222
    classDef auth fill:#FB8072,stroke:#777777,color:#222222
    classDef process fill:#BC80BD,stroke:#777777,color:#222222
    classDef transparency fill:#8DD3C7,stroke:#777777,color:#222222
    classDef resultportal fill:#B3DE69,stroke:#777777,color:#222222
    classDef watcher fill:#FFFFB3,stroke:#777777,color:#222222
    classDef decrypt fill:#FDB462,stroke:#777777,color:#222222
    classDef config fill:#CCEBC5,stroke:#777777,color:#222222
    classDef broker fill:#FFED6F,stroke:#777777,color:#222222
    classDef ledger fill:#FCCDE5,stroke:#777777,color:#222222,stroke-dasharray: 4 2
    classDef db fill:#E4F4E4,stroke:#777777,color:#222222

    ADMIN["Election Configuration Component<br/><i>Local desktop application on admin workstation</i>"]

    subgraph UI_TIER["UI-Facing Application Pods <i>(see Diagram 1)</i><br/><i>multiple replicas behind load balancing</i>"]
        direction TB
        VOTER["Voter Component<br/><i>2-6 replicas</i>"]
        TRANSP["Transparency &amp; Audit Component<br/><i>2-6 replicas</i>"]
        RESULT["Result Portal<br/><i>2-4 replicas</i>"]
        WATCHER["Watcher Component<br/><i>2-4 replicas</i>"]
    end

    subgraph API_TIER["Internal API / Service Pods <i>(see Diagram 1)</i><br/><i>multiple replicas; no direct UI</i>"]
        direction TB
        AUTH["Election Authorization Component<br/><i>2-6 replicas</i>"]
        DECRYPT["Threshold Decryption Orchestration Component<br/><i>2-4 replicas</i>"]
    end

    subgraph WORKER_TIER["Election Processing Worker Pool<br/><i>replicated pods scheduled across nodes</i>"]
        direction TB
        PROC1["Processing Pod 1"]
        PROC2["Processing Pod 2"]
        PROC3["Processing Pod 3"]
        PROCN["Processing Pod N<br/><i>autoscaling limit</i>"]
    end

    BROKER{{"Message Broker<br/><i>Kafka / Redpanda<br/>(prototype: single broker;<br/>production: clustered)</i>"}}
    DATA_TIER[("Repository / Data Tier<br/><i>Metadata, VID, authorization,<br/>audit and digest stores<br/>(replication: illustrative)</i>")]
    LEDGER["Canonical Settlement Ledger<br/><i>external blockchain network</i>"]

    ADMIN -.->|local administration| DATA_TIER
    ADMIN -.->|local administration| LEDGER

    UI_TIER --> DATA_TIER
    API_TIER --> DATA_TIER
    WORKER_TIER --> DATA_TIER

    DECRYPT -.->|settlement / verification| LEDGER
    WORKER_TIER -.->|settlement output| LEDGER

    DECRYPT -->|publishes / requests jobs| BROKER
    WORKER_TIER -->|consumes and publishes| BROKER
    WATCHER -->|observes events| BROKER

    %% linkStyle indices = 0-based edge declaration order above (10 edges).
    linkStyle 0,1 stroke:#4D7C4D,stroke-width:2.5px,stroke-dasharray:6 4
    linkStyle 2,3,4 stroke:#15803D,stroke-width:2.5px
    linkStyle 5,6 stroke:#BE123C,stroke-width:2px,stroke-dasharray:6 4
    linkStyle 7,8,9 stroke:#A16207,stroke-width:2.5px

    class ADMIN config
    class VOTER voter
    class TRANSP transparency
    class RESULT resultportal
    class WATCHER watcher
    class AUTH auth
    class DECRYPT decrypt
    class PROC1,PROC2,PROC3,PROCN process
    class BROKER broker
    class DATA_TIER db
    class LEDGER ledger
