---
title: System Logic View (1/2) — Election Setup, Voter Casting & Processing/Settlement
config:
  flowchart:
    rankSpacing: 100
    nodeSpacing: 60
---
flowchart LR
    %% Palette: evenly-spaced categorical hues (ColorBrewer Set3-derived) so
    %% no two components look alike — Transparency API and Result Portal
    %% previously shared one class/color and were indistinguishable.
    %% Split 1/2: covers phases 1-3 of the full HL_LogicView.mmd (no edges
    %% cross into the phase-4/Decryption half kept in HL_LogicView_2.mmd).
    classDef voter fill:#80B1D3,stroke:#777777,color:#222222
    classDef auth fill:#FB8072,stroke:#777777,color:#222222
    classDef process fill:#BC80BD,stroke:#777777,color:#222222
    classDef config fill:#CCEBC5,stroke:#777777,color:#222222
    classDef broker fill:#FFED6F,stroke:#777777,color:#222222
    classDef ledger fill:#FCCDE5,stroke:#777777,color:#222222,stroke-dasharray: 4 2
    classDef ttp fill:#BEBADA,stroke:#777777,color:#222222,stroke-dasharray: 4 2
    classDef db fill:#E4F4E4,stroke:#777777,color:#222222

    subgraph P1["1. Election Setup"]
        CONFIG["Election Configuration Component<br/><i>(Desktop App)</i>"]
        META[("Election Metadata Repository")]
    end

    subgraph P2["2. Voter Casting &amp; Authorization"]
        TTP["TTP Authentication Service<br/><i>(external)</i>"]
        VC["Voter Component<br/><i>(Client App)</i>"]
        AUTH["Election Authorization Component<br/><i>(API)</i>"]
        VID[("VID Repository")]
        VAUTH[("Voting Authorization Repository")]
    end

    BROKER{{"Message Broker<br/><i>(Durable Queue)</i>"}}

    subgraph P3["3. Processing &amp; Settlement"]
        PROCESS["Election Processing Component<br/><i>(Worker Service)</i>"]
        AUDIT[("Audit Repository")]
    end
    BC["Canonical Settlement Ledger<br/><i>(external)</i>"]

    %% Setup
    CONFIG -->|Publish metadata| META
    CONFIG -->|Init program| BC

    %% Voter casting & authorization
    VC -->|Authenticate| TTP
    VC -->|Resolve VID/JWT| AUTH
    AUTH -->|View/create mapping| VID
    AUTH -->|Verify/consume auth| VAUTH
    VC -.->|Fetch metadata| META
    VC -->|Publish ballot| BROKER

    %% Processing & settlement
    PROCESS -->|Consume ballots| BROKER
    PROCESS -->|Anchor root+proof| BC
    PROCESS -->|Log evidence| AUDIT

    %% Each edge is colored a darker shade of its SOURCE component's fill,
    %% so a line can be traced back to its origin even where lines cross.
    %% Bolder stroke-width + larger dashes for stronger visibility.
    %% Indices below = 0-based edge declaration order above (11 edges).
    linkStyle 0,1 stroke:#4C9A6E,stroke-width:2.5px
    linkStyle 2,3,7 stroke:#2E5F8A,stroke-width:2.5px
    linkStyle 4,5 stroke:#B33A2E,stroke-width:2.5px
    linkStyle 6 stroke:#2E5F8A,stroke-width:2.5px,stroke-dasharray:6 4
    linkStyle 8,9,10 stroke:#7A4A7B,stroke-width:2.5px

    class CONFIG config
    class META db
    class TTP ttp
    class VC voter
    class AUTH auth
    class VID db
    class VAUTH db
    class BROKER broker
    class PROCESS process
    class AUDIT db
    class BC ledger
