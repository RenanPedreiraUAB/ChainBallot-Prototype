{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Transparency": {
    "ProjectionStorePath": "",
    "AuthoritativeDigestSourceMode": "Http",
    "MetadataDigestEndpointTemplate": "http://localhost:8088/digests/metadata/{electionId}.json",
    "AuditDigestEndpointTemplate": "http://localhost:8088/digests/audit/{electionId}.json",
    "AuthoritativeHttpTimeoutSeconds": 10,
    "AuthoritativeMetadataDigests": {},
    "AuthoritativeAuditDigests": {},
    "AutoReindexEnabled": false,
    "AutoReindexIntervalSeconds": 60,
    "AutoReindexElectionIds": [],
    "SolanaReadMode": "Http",
    "SolanaElectionStateEndpointTemplate": "http://localhost:8899",
    "SolanaHttpTimeoutSeconds": 10,
    "MockSolanaFinalizedStates": {},
    "Authentication": {
      "HeaderName": "X-Transparency-Auth",
      "Credentials": [
        {
          "Token": "CHANGE_ME_TRANSPARENCY_INGESTION_TOKEN",
          "Name": "transparency-ingestion-service",
          "Roles": [ "transparency.ingestion" ]
        },
        {
          "Token": "CHANGE_ME_TRANSPARENCY_RECONCILIATION_TOKEN",
          "Name": "transparency-reconciliation-operator",
          "Roles": [ "transparency.reconciliation" ]
        }
      ]
    }
  }
}
