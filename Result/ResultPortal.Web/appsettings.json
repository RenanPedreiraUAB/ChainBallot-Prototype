{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ResultPortal": {
    "TransparencyBaseUrl": "http://localhost:5284",
    "TransparencyTimeoutSeconds": 10,
    "AuthMode": "Open",
    "HeaderAuthHeaderName": "X-ResultPortal-Auth",
    "HeaderAuthToken": "change-me-in-production",
    "HeaderAuthRoles": [
      "result-reader"
    ],
    "OidcAuthority": "",
    "OidcClientId": "",
    "OidcClientSecret": "",
    "OidcResponseType": "code",
    "OidcCallbackPath": "/signin-oidc",
    "OidcSignedOutCallbackPath": "/signout-callback-oidc",
    "OidcUsePkce": true,
    "OidcRequireHttpsMetadata": true,
    "OidcScopes": [
      "openid",
      "profile",
      "email"
    ],
    "DefaultElectionVisibility": "Public",
    "PublicElectionIds": [],
    "PrivateElectionIds": [],
    "PrivateElectionViewerRole": "result-reader",
    "HidePrivateElectionExistence": true
  }
}
