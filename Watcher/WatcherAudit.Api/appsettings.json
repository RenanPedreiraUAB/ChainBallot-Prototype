{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Watcher": {
    "TransparencyBaseUrl": "http://localhost:5284",
    "TransparencyTimeoutSeconds": 10,
    "DigestSourceMode": "Http",
    "DigestHttpTimeoutSeconds": 5,
    "MetadataDigestEndpointTemplate": "http://localhost:8088/digests/metadata/{electionId}.json",
    "AuditDigestEndpointTemplate": "http://localhost:8088/digests/audit/{electionId}.json",
    "MetadataDigests": {},
    "AuditDigests": {},
    "ReportStorePath": "",
    "ReportSigningKey": "watcher-dev-key"
  }
}
