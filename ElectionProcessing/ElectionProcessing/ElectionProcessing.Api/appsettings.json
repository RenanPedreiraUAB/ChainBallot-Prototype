{
  "Processing": {
    "QueueMode": "Kafka",
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "Topic": "chainballot-ballots",
      "ConsumerGroupId": "chainballot-outbound",
      "PollBatchSize": 64,
      "ConsumeTimeoutMilliseconds": 100
    },
    "MaxBallotsPerBatch": 32,
    "MaxBatchWaitSeconds": 20,
    "PollIntervalMilliseconds": 1000,
    "ProjectionPublishing": {
      "Enabled": true,
      "BaseUrl": "http://localhost:5264",
      "TimeoutSeconds": 10,
      "LifecycleState": "Open"
    },
    "ProverMode": "DeterministicStub",
    "ExternalProver": {
      "Endpoint": "",
      "ApiKey": "",
      "TimeoutSeconds": 30
    },
    "LocalProcessProver": {
      "ExecutablePath": "",
      "Arguments": "",
      "WorkingDirectory": "",
      "TimeoutSeconds": 60
    },
    "SettlementNetwork": "solana-devnet",
    "SettlementProgramId": "chainballot-program-v2",
    "SettlementCommitment": "confirmed",
    "SettlementMode": "SolanaRpc",
    "SolanaRpc": {
      "RpcEndpoint": "http://localhost:8899",
      "RpcApiKey": "",
      "AnchorSubmitMethod": "chainballot_anchorBatch",
      "TimeoutSeconds": 30
    },
    "Authentication": {
      "HeaderName": "X-Processing-Auth",
      "Credentials": [
        {
          "Token": "CHANGE_ME_PROCESSING_OPERATOR_TOKEN",
          "Name": "processing-operator",
          "Roles": [ "processing.operator" ]
        },
        {
          "Token": "CHANGE_ME_PROCESSING_INGEST_TOKEN",
          "Name": "processing-ingest-service",
          "Roles": [ "processing.ingest" ]
        }
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
